{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-context-budget.py\"",
            "timeout": 5,
            "statusMessage": "Checking repository inspection output"
          }
        ]
      }
    ]
  }
}
